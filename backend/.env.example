# OpenAI (Already in use for your RAG logic)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration
# The URL of your Supabase project (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=your_supabase_project_url_here

# The anon/public key for client-side or basic requests
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: The service role key for admin/backend tasks (never expose to frontend!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# If using direct Postgres connections (like asyncpg, psycopg2, or SQLAlchemy in Python):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
